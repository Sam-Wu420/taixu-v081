{
  "name": "fanren-xiuxian-desktop",
  "productName": "凡人修仙传",
  "version": "0.52.9",
  "description": "凡人修仙传 v0.52.9 · Windows 桌面版",
  "main": "main.js",
  "author": "qwasx",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win portable --x64",
    "dist:nsis": "electron-builder --win nsis --x64",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qwasx.fanren",
    "productName": "凡人修仙传",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "game",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "凡人修仙传-v${version}-Windows-x64.${ext}"
    },
    "portable": {
      "artifactName": "凡人修仙传-v${version}-Windows-x64.${ext}"
    },
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "**/*.webp",
      "**/*.json"
    ]
  }
}
